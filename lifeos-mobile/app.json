{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos-mobile",
    "version": "0.1.0",
    "scheme": "lifeos",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.geogeorge.lifeos",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LifeOS to access location for geofence reminders.",
          "isAndroidBackgroundPermissionGranted": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9330ab4f-01c6-4199-914b-f9d74283741a"
      }
    },
    "owner": "geogeorge46"
  }
}
