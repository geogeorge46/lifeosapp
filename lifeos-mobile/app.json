{
  "expo": {
    "name": "Synora",
    "slug": "lifeos-mobile",
    "version": "0.1.0",
    "scheme": "synora",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.geogeorge.lifeos",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Synora to access location for geofence reminders.",
          "isAndroidBackgroundPermissionGranted": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9330ab4f-01c6-4199-914b-f9d74283741a"
      }
    },
    "owner": "geogeorge46"
  }
}
