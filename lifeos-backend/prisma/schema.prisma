datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentType {
  TEXT
  AUDIO
}

enum BrainDumpStatus {
  INBOX
  PROCESSED
  ARCHIVED
}

enum TaskStatus {
  CAPTURED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NOT_COMPLETED
  CANCELLED
  DEFERRED
}

enum TransactionType {
  EXPENSE
  LENT
  BORROWED
}

enum TransactionStatus {
  PENDING
  SETTLED
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum GeofenceTriggerType {
  ENTER
  EXIT
}

model User {
  id                      String                   @id @db.Uuid
  email                   String                   @unique
  name                    String?
  pushToken               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  brainDumps              BrainDump[]
  brainDumpCollections    BrainDumpCollection[]
  ideas                   Idea[]
  tasks                   Task[]
  events                  Event[]
  places                  Place[]
  people                  Person[]
  transactions            Transaction[]
  dailyRecaps             DailyRecap[]
  notificationPreferences NotificationPreference[]
  notificationLogs        NotificationLog[]
  geofenceTriggers        GeofenceTrigger[]
  habits                  Habit[]
  relationships           Relationship[]
  occasions               Occasion[]
  taskOccurrences         TaskOccurrence[]
  taskHistories           TaskHistory[]
  habitCompletions        HabitCompletion[]
  triggers                Trigger[]

  @@map("users")
}

model BrainDumpCollection {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   BrainDump[]

  @@unique([userId, name])
  @@map("brain_dump_collections")
}

model BrainDump {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  contentType  ContentType
  content      String               // Text content or Audio file URL
  rawText      String?              // Audio transcription text
  status       BrainDumpStatus      @default(INBOX)
  type         String?              // THOUGHT, IDEA, QUESTION, PROBLEM, NOTE
  collectionId String?              @db.Uuid
  archived     Boolean              @default(false)
  personId     String?              @db.Uuid
  placeId      String?              @db.Uuid
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   BrainDumpCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  person       Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  place        Place?               @relation(fields: [placeId], references: [id], onDelete: SetNull)
  task         Task?
  event        Event?
  idea         Idea?

  @@index([userId, status, createdAt])
  @@map("brain_dumps")
}

model Task {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  brainDumpId         String?           @unique @db.Uuid
  ideaId              String?           @db.Uuid
  title               String
  description         String?
  source              String            @default("MANUAL") // "MANUAL", "INBOX_TEXT", "INBOX_AUDIO"
  priority            String            @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  recurrenceRule      String?           // RRULE string for recurring patterns
  fuzzyDate           String?
  personId            String?           @db.Uuid
  placeId             String?           @db.Uuid
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brainDump           BrainDump?        @relation(fields: [brainDumpId], references: [id], onDelete: SetNull)
  idea                Idea?             @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  person              Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  place               Place?            @relation(fields: [placeId], references: [id], onDelete: SetNull)
  occurrences         TaskOccurrence[]
  history             TaskHistory[]
  geofenceTriggers    GeofenceTrigger[]

  @@index([userId, createdAt])
  @@map("tasks")
}

model Place {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  name         String
  address      String?
  latitude     Float
  longitude    Float
  radius       Float             @default(150.0) // Default radius in meters (configurable 50-500m)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedPeople PersonPlace[]
  geofences    GeofenceTrigger[]
  tasks        Task[]
  brainDumps   BrainDump[]
  ideas        Idea[]
  transactions Transaction[]

  @@index([userId])
  @@map("places")
}

model Person {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String
  phone        String?
  relationship String?
  birthday     DateTime?     @db.Date
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags             PersonTag[]
  linkedPlaces     PersonPlace[]
  transactions     Transaction[]
  tasks            Task[]
  brainDumps       BrainDump[]
  ideas            Idea[]
  triggers         Trigger[]
  relationshipsAsA Relationship[] @relation("PersonARelations")
  relationshipsAsB Relationship[] @relation("PersonBRelations")
  occasions        Occasion[]

  @@index([userId])
  @@map("people")
}

model Idea {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  title       String
  description String?
  notes       String?
  category    String     @default("General")
  brainDumpId String?    @unique @db.Uuid
  personId    String?    @db.Uuid
  placeId     String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brainDump   BrainDump? @relation(fields: [brainDumpId], references: [id], onDelete: SetNull)
  person      Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  place       Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([userId])
  @@map("ideas")
}

model Tag {
  id     String      @id @default(uuid()) @db.Uuid
  name   String      @unique
  people PersonTag[]

  @@map("tags")
}

model PersonTag {
  personId String @db.Uuid
  tagId    String @db.Uuid
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([personId, tagId])
  @@map("person_tags")
}

model PersonPlace {
  personId String @db.Uuid
  placeId  String @db.Uuid
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  place    Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([personId, placeId])
  @@map("person_places")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  personId        String?           @db.Uuid
  placeId         String?           @db.Uuid
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType
  description     String
  dueDate         DateTime?
  status          TransactionStatus @default(PENDING)
  category        String?
  settledAt       DateTime?
  parentId        String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  person          Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  place           Place?            @relation(fields: [placeId], references: [id], onDelete: SetNull)
  parent          Transaction?      @relation("PartialPayments", fields: [parentId], references: [id], onDelete: SetNull)
  partialPayments Transaction[]     @relation("PartialPayments")
  triggers        Trigger[]

  @@index([userId, type, status])
  @@map("transactions")
}

model DailyRecap {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  date        DateTime @db.Date
  summary     String
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_recaps")
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model NotificationLog {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  title     String
  body      String
  payload   Json?
  status    NotificationStatus @default(QUEUED)
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notification_logs")
}

model GeofenceTrigger {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  placeId     String              @db.Uuid
  taskId      String?             @db.Uuid
  triggerType GeofenceTriggerType
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  place       Place               @relation(fields: [placeId], references: [id], onDelete: Cascade)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, placeId, active])
  @@map("geofence_triggers")
}

model TaskOccurrence {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String?         @db.Uuid
  taskId        String          @db.Uuid
  status        TaskStatus      @default(CAPTURED)
  scheduledDate DateTime        @db.Date
  scheduledTime String?         // e.g. "10:00 AM" or null for "Anytime"
  completedAt   DateTime?
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  triggers      Trigger[]

  @@index([taskId, scheduledDate, status])
  @@map("task_occurrences")
}

model TaskHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  taskId        String   @db.Uuid
  fromDate      DateTime @db.Date
  toDate        DateTime @db.Date
  rescheduledAt DateTime @default(now())
  reason        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_histories")
}

model Event {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  brainDumpId    String?    @unique @db.Uuid
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  recurrenceRule String?
  placeId        String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brainDump      BrainDump? @relation(fields: [brainDumpId], references: [id], onDelete: SetNull)
  triggers       Trigger[]

  @@index([userId, startDate])
  @@map("events")
}

enum TriggerType {
  TIME
  LOCATION
  BEFORE_EVENT
  RECURRING
  OVERDUE
  NOT_COMPLETED
  BIRTHDAY
}

model Trigger {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String?         @db.Uuid
  type             TriggerType
  scheduledTime    DateTime?
  placeId          String?         @db.Uuid
  taskOccurrenceId String?         @db.Uuid
  eventId          String?         @db.Uuid
  personId         String?         @db.Uuid
  transactionId    String?         @db.Uuid
  occasionId       String?         @db.Uuid
  fired            Boolean         @default(false)
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskOccurrence   TaskOccurrence? @relation(fields: [taskOccurrenceId], references: [id], onDelete: Cascade)
  event            Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person           Person?         @relation(fields: [personId], references: [id], onDelete: Cascade)
  transaction      Transaction?    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  occasion         Occasion?       @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@map("triggers")
}

model Habit {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  title         String
  streak        Int               @default(0)
  longestStreak Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions   HabitCompletion[]

  @@index([userId])
  @@map("habits")
}

model HabitCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  habitId     String   @db.Uuid
  date        DateTime @db.Date
  completedAt DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_completions")
}

model Relationship {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  personAId String   @db.Uuid
  personBId String   @db.Uuid
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  personA   Person   @relation("PersonARelations", fields: [personAId], references: [id], onDelete: Cascade)
  personB   Person   @relation("PersonBRelations", fields: [personBId], references: [id], onDelete: Cascade)

  @@unique([personAId, personBId, type])
  @@map("relationships")
}

model Occasion {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @db.Uuid
  personId  String    @db.Uuid
  title     String
  date      DateTime  @db.Date
  type      String    // "ANNIVERSARY", "EXAM", "INTERVIEW", "CUSTOM"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  triggers  Trigger[]

  @@map("occasions")
}

